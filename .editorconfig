root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Fixed-width host records (TSK-RECORD, 300 characters): the trailing padding is data.
[*.dat]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
